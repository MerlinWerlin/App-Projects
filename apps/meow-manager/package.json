{
  "name": "meow-manager",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "test": "node --test \"src/core/*.test.ts\" && node scripts/verify-character.ts && node scripts/verify-frames.ts",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
    "export": "expo export --platform ios --platform android --platform web",
    "character:export": "node scripts/export-character.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.31",
    "expo-calendar": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-gl": "57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.29",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "three": "0.166.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "@types/three": "0.166.0",
    "typescript": "~6.0.3"
  }
}
