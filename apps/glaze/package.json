{
  "name": "glaze",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "trial": "expo start --go --tunnel",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "test": "node --test \"src/core/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc -p scripts/tsconfig.ui.json",
    "typecheck:core": "tsc --noEmit --strict --skipLibCheck --target es2022 --module nodenext --moduleResolution nodenext --allowImportingTsExtensions src/core/*.ts"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.1",
    "@expo-google-fonts/unbounded": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.31",
    "expo-blur": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-mail-composer": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-router": "~57.0.29",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}