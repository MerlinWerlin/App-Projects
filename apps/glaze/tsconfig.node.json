{
  "//": "Node-side TypeScript (T52): tests (node:test), ops build scripts and app.config.ts, with Node's types. Run: npx tsc -p tsconfig.node.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/**/*.test.ts",
    "app/**/*.test.ts",
    "ops/**/*.ts",
    "app.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
