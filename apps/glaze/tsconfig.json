{
  "//": "App code only (T52, fb-1023). Node-side files (*.test.ts, ops/*.ts, app.config.ts) are checked by tsconfig.node.json with types [node]; the cloud UI stub check is scripts/tsconfig.ui.json.",
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "targets",
    "native-plugins",
    ".expo/web",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "ops",
    "scripts",
    "app.config.ts"
  ]
}
