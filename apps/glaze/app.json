{
  "expo": {
    "name": "Glaze",
    "slug": "glaze",
    "scheme": "glaze",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/8dcff573-80a3-457e-9791-f41552a0d678"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "bundleIdentifier": "com.jared797.glaze",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Glaze uses your photos and videos to make icons, wallpapers and Live Photos. They never leave your phone.",
        "NSPhotoLibraryAddUsageDescription": "Glaze saves the icons and wallpapers you make to your photo library.",
        "CFBundleLocalizations": [
          "en",
          "es",
          "fr",
          "de",
          "it",
          "pt-BR",
          "ja",
          "ko",
          "zh-Hans",
          "hi",
          "ar"
        ],
        "CFBundleAllowMixedLocalizations": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jared797.glaze",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#1C1442"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Glaze uses your photos and videos to make icons, wallpapers and Live Photos. They never leave your phone."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Glaze uses your photos and videos to make icons, wallpapers and Live Photos. They never leave your phone.",
          "savePhotosPermission": "Glaze saves the icons and wallpapers you make to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F4F1F7",
          "dark": {
            "image": "./assets/brand/splash-icon-dark.png",
            "backgroundColor": "#0F0D12"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "jared797",
    "extra": {
      "eas": {
        "projectId": "8dcff573-80a3-457e-9791-f41552a0d678"
      }
    },
    "icon": "./assets/brand/icon.png"
  }
}
