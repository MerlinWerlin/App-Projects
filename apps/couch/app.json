{
  "expo": {
    "name": "Couch",
    "slug": "couch-remote",
    "scheme": "couch",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jared797.couch",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Couch finds and controls TVs and streaming players on your Wi-Fi. Nothing leaves your home network.",
        "NSBonjourServices": [
          "_androidtvremote2._tcp",
          "_amzn-wplay._tcp",
          "_viziocast._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "CFBundleAllowMixedLocalizations": true
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": "./assets/brand/icon.png"
    },
    "android": {
      "package": "com.jared797.couch",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#2B2B2C"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "./plugins/withLanAccess",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E0E0F",
          "dark": {
            "image": "./assets/brand/splash-icon.png",
            "backgroundColor": "#0E0E0F"
          }
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "supportsRTL": true
    },
    "owner": "jared797",
    "icon": "./assets/brand/icon.png",
    "backgroundColor": "#0E0E0F",
    "newArchEnabled": true
  }
}
