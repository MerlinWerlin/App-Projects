{
  "expo": {
    "name": "Couch",
    "slug": "couch-remote",
    "scheme": "couch",
    "version": "1.0.4",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jared797.couch",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Couch finds and controls TVs and streaming players on your Wi-Fi. Nothing leaves your home network.",
        "NSBonjourServices": [
          "_androidtvremote2._tcp",
          "_amzn-wplay._tcp",
          "_viziocast._tcp",
          "_googlecast._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "CFBundleAllowMixedLocalizations": true
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": "./assets/brand/icon.png"
    },
    "android": {
      "package": "com.jared797.couch",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#2B2B2C"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "./plugins/withLanAccess",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E0E0F",
          "dark": {
            "image": "./assets/brand/splash-icon.png",
            "backgroundColor": "#0E0E0F"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Couch shows the photos and videos you pick on your TV.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportsRTL": true,
      "eas": {
        "projectId": "13c9422c-742a-4c5b-aa36-c9ad87cd7c83"
      }
    },
    "owner": "jared797",
    "icon": "./assets/brand/icon.png",
    "backgroundColor": "#0E0E0F",
    "newArchEnabled": true
  }
}
