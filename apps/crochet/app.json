{
  "expo": {
    "name": "Rowlight",
    "slug": "rowlight",
    "scheme": "rowlight",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/icon.png",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.jared797.rowlight",
      "infoPlist": {
        "NSCameraUsageDescription": "Rowlight uses the camera to photograph your projects and yarn labels. Photos stay on your phone.",
        "NSPhotoLibraryUsageDescription": "Rowlight lets you add progress photos and pattern screenshots. They stay on your phone.",
        "CFBundleAllowMixedLocalizations": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jared797.rowlight",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#B5476A"
      },
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rowlight lets you add progress photos and pattern screenshots. They stay on your phone.",
          "cameraPermission": "Rowlight uses the camera to photograph your projects and yarn labels. Photos stay on your phone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF6EF",
          "dark": {
            "image": "./assets/brand/splash-icon.png",
            "backgroundColor": "#191412"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "jared797",
    "extra": {
      "eas": {
        "projectId": "a0d0b33c-6067-459f-9004-2966d23fa85a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/a0d0b33c-6067-459f-9004-2966d23fa85a",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
