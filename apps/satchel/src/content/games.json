  "decks": {
    "rather": [
      { "id": "wyr-1", "text": "Would you rather fly in a hot air balloon or ride in a submarine?" },
      { "id": "wyr-2", "text": "Would you rather have breakfast for dinner or dinner for breakfast?" },
      { "id": "wyr-3", "text": "Would you rather visit a snowy mountain or a sunny beach?" },
      { "id": "wyr-4", "text": "Would you rather be able to speak every language or play every instrument?" },
      { "id": "wyr-5", "text": "Would you rather sleep in a treehouse or a tent on the sand?" },
      { "id": "wyr-6", "text": "Would you rather have a pet penguin or a pet owl?" },
      { "id": "wyr-7", "text": "Would you rather travel by train for a week or by boat for a week?" },
      { "id": "wyr-8", "text": "Would you rather eat only sweet food or only salty food for a day?" },
      { "id": "wyr-9", "text": "Would you rather explore a jungle or a desert?" },
      { "id": "wyr-10", "text": "Would you rather be able to fly or breathe underwater?" },
      { "id": "wyr-11", "text": "Would you rather live in a castle or a lighthouse?" },
      { "id": "wyr-12", "text": "Would you rather have a suitcase that packs itself or a map that never gets you lost?" },
      { "id": "wyr-13", "text": "Would you rather see a whale or a wild bear (from far away)?" },
      { "id": "wyr-14", "text": "Would you rather always be too warm or always a bit too cold?" },
      { "id": "wyr-15", "text": "Would you rather visit the past or the future for one day?" },
      { "id": "wyr-16", "text": "Would you rather have a robot helper or a talking dog?" },
      { "id": "wyr-17", "text": "Would you rather spend a day in a giant library or a giant toy shop?" },
      { "id": "wyr-18", "text": "Would you rather ride a camel or an elephant?" },
      { "id": "wyr-19", "text": "Would you rather build a sandcastle or a snowman?" },
      { "id": "wyr-20", "text": "Would you rather be the pilot or the train driver?" },
      { "id": "wyr-21", "text": "Would you rather try the spiciest dish or the strangest-looking fruit?" },
      { "id": "wyr-22", "text": "Would you rather have a window seat forever or an aisle seat forever?" },
      { "id": "wyr-23", "text": "Would you rather go stargazing or sunrise watching?" },
      { "id": "wyr-24", "text": "Would you rather be as tiny as an ant or as tall as a giraffe for a day?" },
      { "id": "wyr-25", "text": "Would you rather paint a mural or write a song about this trip?" },
      { "id": "wyr-26", "text": "Would you rather swim with dolphins or ride a roller coaster?" },
      { "id": "wyr-27", "text": "Would you rather have a day with no rules or a day where you make the rules?" },
      { "id": "wyr-28", "text": "Would you rather eat pancakes or waffles every Sunday?" },
      { "id": "wyr-29", "text": "Would you rather meet a friendly alien or a friendly dinosaur?" },
      { "id": "wyr-30", "text": "Would you rather go on a trip with no phone or a trip with no snacks?" }
    ],
    "tell": [
      { "id": "tell-1", "text": "Tell me about the best meal you have ever had." },
      { "id": "tell-2", "text": "Tell me about a place you would love to visit one day, and why." },
      { "id": "tell-3", "text": "Tell me about something that made you laugh this week." },
      { "id": "tell-4", "text": "Tell me about your dream house." },
      { "id": "tell-5", "text": "Tell me about a time you were really brave." },
      { "id": "tell-6", "text": "Tell me about the animal you would most like to be." },
      { "id": "tell-7", "text": "Tell me about a song that always makes you happy." },
      { "id": "tell-8", "text": "Tell me about a superpower you would choose and what you would do first." },
      { "id": "tell-9", "text": "Tell me about your favourite way to spend a rainy day." },
      { "id": "tell-10", "text": "Tell me about someone who is kind to you." },
      { "id": "tell-11", "text": "Tell me about a new food you would like to try." },
      { "id": "tell-12", "text": "Tell me about the perfect sandwich." },
      { "id": "tell-13", "text": "Tell me about a game you made up." },
      { "id": "tell-14", "text": "Tell me about something you are really good at." },
      { "id": "tell-15", "text": "Tell me about a skill you want to learn." },
      { "id": "tell-16", "text": "Tell me about the funniest dream you remember." },
      { "id": "tell-17", "text": "Tell me about your favourite season and what you do in it." },
      { "id": "tell-18", "text": "Tell me about an invention the world needs." },
      { "id": "tell-19", "text": "Tell me about a book or story you would step into." },
      { "id": "tell-20", "text": "Tell me about a place that feels like home." },
      { "id": "tell-21", "text": "Tell me about what you would pack for a trip to the moon." },
      { "id": "tell-22", "text": "Tell me about a rule you would add to your family." },
      { "id": "tell-23", "text": "Tell me about your favourite smell." },
      { "id": "tell-24", "text": "Tell me about a holiday tradition you love." },
      { "id": "tell-25", "text": "Tell me about something small that makes a day better." },
      { "id": "tell-26", "text": "Tell me about the view you would want from your bedroom window." },
      { "id": "tell-27", "text": "Tell me about a time you helped someone." },
      { "id": "tell-28", "text": "Tell me about what you want to be really good at when you are older." }
    ],
    "memory": [
      { "id": "mem-1", "text": "What has been the best moment of this trip so far?" },
      { "id": "mem-2", "text": "What is the tastiest thing you have eaten on this trip?" },
      { "id": "mem-3", "text": "What surprised you most about this place?" },
      { "id": "mem-4", "text": "Which sound will you remember from this trip?" },
      { "id": "mem-5", "text": "What made everyone laugh today?" },
      { "id": "mem-6", "text": "If you could bring one thing home from here, what would it be?" },
      { "id": "mem-7", "text": "What is something new you tried on this trip?" },
      { "id": "mem-8", "text": "Who was the kindest stranger you met?" },
      { "id": "mem-9", "text": "What would you tell a friend to do here?" },
      { "id": "mem-10", "text": "What is the most beautiful thing you have seen so far?" },
      { "id": "mem-11", "text": "Which word or phrase did you learn here?" },
      { "id": "mem-12", "text": "What was the silliest thing that happened?" },
      { "id": "mem-13", "text": "Where would you go back to tomorrow if you could?" },
      { "id": "mem-14", "text": "What was hard about today, and what helped?" },
      { "id": "mem-15", "text": "What is different here from home?" },
      { "id": "mem-16", "text": "Which picture from today would you put on the fridge?" },
      { "id": "mem-17", "text": "Give today a title, like the name of a book." },
      { "id": "mem-18", "text": "What colour would you give this trip, and why?" },
      { "id": "mem-19", "text": "What was the best snack of the journey?" },
      { "id": "mem-20", "text": "What did you see out of the window that you want to remember?" },
      { "id": "mem-21", "text": "Describe today in three words." },
      { "id": "mem-22", "text": "What are you most looking forward to next on this trip?" },
      { "id": "mem-23", "text": "What would you name the place we are staying?" },
      { "id": "mem-24", "text": "Which moment would you like to live again?" }
