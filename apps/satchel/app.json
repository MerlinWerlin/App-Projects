{
  "expo": {
    "name": "Satchel",
    "slug": "satchel",
    "scheme": "satchel",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F4F1EA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jared797.satchel",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Satchel uses your location only when you ask, for example Where am I? on the map, a near-me search, planning a walk or sharing where you are, and for Find my way back while that screen is open. Never in the background. A near-me search outside your downloaded city maps sends that spot to OpenStreetMap.",
        "NSPhotoLibraryUsageDescription": "Satchel lets you add photos from your library to tickets, bookings, documents, receipts, cards, trip covers and your trip journal. They are copied into Satchel and stay on your phone.",
        "NSFaceIDUsageDescription": "Satchel uses Face ID to lock your document vault (passport, visa and licence copies) and any hotel door or key box codes you choose to hide. Face ID data never leaves your phone.",
        "NSContactsUsageDescription": "Satchel lets you pick contacts for your emergency card, help cards and trusted contacts. Only the contacts you pick are saved, on your phone.",
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "Satchel only uses the camera when you choose to take a photo, for example of a ticket, receipt, membership card, rental car or lost bag, or for your trip journal. The photo is copied into Satchel and stays on your phone.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Satchel trip",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "app.satchel.trip"
            ]
          },
          {
            "CFBundleTypeName": "Satchel backup",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "app.satchel.backup"
            ]
          },
          {
            "CFBundleTypeName": "PDF document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          },
          {
            "CFBundleTypeName": "Image",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.image"
            ]
          },
          {
            "CFBundleTypeName": "Plain text",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.plain-text"
            ]
          },
          {
            "CFBundleTypeName": "Email message",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.apple.mail.email",
              "public.email-message"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "app.satchel.trip",
            "UTTypeDescription": "Satchel trip",
            "UTTypeConformsTo": [
              "public.json",
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "satchel"
              ],
              "public.mime-type": [
                "application/vnd.satchel.trip+json"
              ]
            }
          },
          {
            "UTTypeIdentifier": "app.satchel.backup",
            "UTTypeDescription": "Satchel backup",
            "UTTypeConformsTo": [
              "public.json",
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "satchelbackup"
              ],
              "public.mime-type": [
                "application/vnd.satchel.backup+json"
              ]
            }
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.jared797.satchel",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F1EA"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E1320"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Satchel uses your location only when you ask, for example Where am I? on the map, a near-me search, planning a walk or sharing where you are, and for Find my way back while that screen is open. Never in the background. A near-me search outside your downloaded city maps sends that spot to OpenStreetMap.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Satchel lets you add photos from your library to tickets, bookings, documents, receipts, cards, trip covers and your trip journal. They are copied into Satchel and stay on your phone.",
          "cameraPermission": "Satchel only uses the camera when you choose to take a photo, for example of a ticket, receipt, membership card, rental car or lost bag, or for your trip journal. The photo is copied into Satchel and stays on your phone.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/with-open-in"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "owner": "jared797",
    "newArchEnabled": true
  }
}
