{
  "expo": {
    "name": "Satchel",
    "slug": "satchel",
    "scheme": "satchel",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F4F1EA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jared797.satchel",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Satchel checks your location once, only when you tap Where am I?, to show you on the map. It never tracks you in the background. Your location stays on your phone.",
        "NSPhotoLibraryUsageDescription": "Satchel lets you attach ticket and booking images from your photos. They are copied into Satchel and stay on your phone.",
        "NSFaceIDUsageDescription": "Satchel uses Face ID to lock your document vault (passport, visa and licence copies).",
        "NSContactsUsageDescription": "Satchel lets you pick emergency contacts for your emergency card. Only the contacts you pick are saved, on your phone.",
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "Satchel only uses the camera if you choose to photograph a ticket or booking. The photo is copied into Satchel and stays on your phone."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.jared797.satchel",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F1EA"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E1320"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Satchel checks your location once, only when you tap Where am I?, to show you on the map. It never tracks you in the background. Your location stays on your phone.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Satchel lets you attach ticket and booking images from your photos. They are copied into Satchel and stay on your phone.",
          "cameraPermission": "Satchel only uses the camera if you choose to photograph a ticket or booking. The photo is copied into Satchel and stays on your phone.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "owner": "jared797",
    "newArchEnabled": true
  }
}
